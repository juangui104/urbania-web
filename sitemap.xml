---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ "/" | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>1.0</priority></url>
  <url><loc>{{ "/nosotros/" | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>0.8</priority></url>
  <url><loc>{{ "/proyectos/" | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>0.9</priority></url>
  {% for p in site.proyectos %}<url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>0.7</priority></url>
  {% endfor %}<url><loc>{{ "/blog/" | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>0.8</priority></url>
  {% for p in site.posts %}<url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.date | date_to_xmlschema }}</lastmod><priority>0.6</priority></url>
  {% endfor %}<url><loc>{{ "/contacto/" | absolute_url }}</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><priority>0.7</priority></url>
</urlset>
